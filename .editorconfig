# Matches tree-sitter's, which is what the generated parsers are written to.
root = true

[*]
indent_style = space
indent_size = 2
tab_width = 8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 2
indent_style = tab

[Makefile]
indent_style = tab
indent_size = 8
