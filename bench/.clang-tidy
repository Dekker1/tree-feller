# The harnesses, held to the same bar as the library except where a test is
# allowed to do things a library is not: encode handles in pointers, and treat
# running out of memory as fatal rather than recoverable.
---
InheritParentConfig: true
Checks: '
  -performance-no-int-to-ptr,
  -clang-analyzer-unix.Malloc,
  -clang-analyzer-optin.portability.UnixAPI,
  -clang-analyzer-security.ArrayBound,
'
